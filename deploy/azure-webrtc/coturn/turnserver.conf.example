# Coturn configuration for the public MAGPIE demonstration service.
# Copy to /etc/turnserver.conf and replace every REPLACE_* value.

listening-port=3478
listening-ip=REPLACE_AZURE_PRIVATE_IP
relay-ip=REPLACE_AZURE_PRIVATE_IP
external-ip=REPLACE_AZURE_PUBLIC_IP/REPLACE_AZURE_PRIVATE_IP

fingerprint
realm=magpie-demo
use-auth-secret
static-auth-secret=REPLACE_WITH_THE_SAME_SECRET_USED_BY_THE_CONTAINER_APP

# Keep the relay-port range deliberately small for a limited public demo.
min-port=49160
max-port=49250

# Allocation and bandwidth safeguards. max-bps and bps-capacity are bytes/s.
user-quota=4
total-quota=100
max-bps=1000000
bps-capacity=10000000
max-allocate-lifetime=600
stale-nonce=600

no-multicast-peers
no-loopback-peers
no-cli

# This template exposes TURN over UDP/TCP without TLS because the example uses
# a public IP address. Add a DNS name, certificate, and tls-listening-port=5349
# before offering turns: URLs.
no-tls

log-file=/var/log/turnserver/turnserver.log
simple-log
